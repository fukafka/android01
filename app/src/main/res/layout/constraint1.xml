<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/KKTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="ConstraintLayoutTest"
        android:textSize="22sp"
        android:textColor="#FFFFFFFF"
        android:background="#FF4CAF50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/KKinput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Input"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/KKTitle"
        app:layout_constraintStart_toStartOf="parent"
        />
    <EditText
        android:id="@+id/Kinput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:background="#FFF4A460"
        app:layout_constraintTop_toBottomOf="@+id/KKinput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/b7"
        style="@style/key"
        android:text="7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b8"
        app:layout_constraintTop_toBottomOf="@id/Kinput"
        app:layout_constraintBottom_toTopOf="@id/b4"
        app:layout_constraintVertical_weight="1"/>
    <Button
        android:id="@+id/b8"
        style="@style/key"
        android:text="8"
        app:layout_constraintStart_toEndOf="@id/b7"
        app:layout_constraintEnd_toStartOf="@id/b9"
        app:layout_constraintTop_toTopOf="@id/b7"
        app:layout_constraintBottom_toBottomOf="@id/b7"/>
    <Button
        android:id="@+id/b9"
        style="@style/key"
        android:text="9"
        app:layout_constraintStart_toEndOf="@id/b8"
        app:layout_constraintEnd_toStartOf="@id/bdiv"
        app:layout_constraintTop_toTopOf="@id/b7"
        app:layout_constraintBottom_toBottomOf="@id/b7" />

    <Button
        android:id="@+id/bdiv"
        style="@style/key"
        android:text="÷"
        app:layout_constraintStart_toEndOf="@id/b9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/b7"
        app:layout_constraintBottom_toBottomOf="@id/b7" />

    <Button
        android:id="@+id/b4"
        style="@style/key"
        android:text="4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b5"
        app:layout_constraintTop_toBottomOf="@id/b7"
        app:layout_constraintBottom_toTopOf="@id/b1"
        app:layout_constraintVertical_weight = "1"/>

    <Button
        android:id="@+id/b5"
        style="@style/key"
        android:text="5"
        app:layout_constraintStart_toEndOf="@id/b4"
        app:layout_constraintEnd_toStartOf="@id/b6"
        app:layout_constraintTop_toTopOf="@id/b4"
        app:layout_constraintBottom_toBottomOf="@id/b4"/>

    <Button
        android:id="@+id/b6"
        style="@style/key"
        android:text="6"
        app:layout_constraintStart_toEndOf="@id/b5"
        app:layout_constraintEnd_toStartOf="@id/bmul"
        app:layout_constraintTop_toTopOf="@id/b4"
        app:layout_constraintBottom_toBottomOf="@id/b4"/>
    <Button
        android:id="@+id/bmul"
        style="@style/key"
        android:text="x"
        app:layout_constraintStart_toEndOf="@id/b6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/b4"
        app:layout_constraintBottom_toBottomOf="@id/b4"/>
    <Button
        android:id="@+id/b1"
        style="@style/key"
        android:text="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b2"
        app:layout_constraintTop_toBottomOf="@id/b4"
        app:layout_constraintBottom_toTopOf="@id/b0"
        app:layout_constraintVertical_weight="1" />

    <Button
        android:id="@+id/b2"
        style="@style/key"
        android:text="2"
        app:layout_constraintStart_toEndOf="@id/b1"
        app:layout_constraintEnd_toStartOf="@id/b3"
        app:layout_constraintTop_toTopOf="@id/b1"
        app:layout_constraintBottom_toBottomOf="@id/b1" />

    <Button
        android:id="@+id/b3"
        style="@style/key"
        android:text="3"
        app:layout_constraintStart_toEndOf="@id/b2"
        app:layout_constraintEnd_toStartOf="@id/bsub"
        app:layout_constraintTop_toTopOf="@id/b1"
        app:layout_constraintBottom_toBottomOf="@id/b1" />

    <Button
        android:id="@+id/bsub"
        style="@style/key"
        android:text="-"
        app:layout_constraintStart_toEndOf="@id/b3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/b1"
        app:layout_constraintBottom_toBottomOf="@id/b1" />

    <Button
        android:id="@+id/b0"
        style="@style/key"
        android:text="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bdot"
        app:layout_constraintTop_toBottomOf="@id/b1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_weight="1" />

    <Button
        android:id="@+id/bdot"
        style="@style/key"
        android:text="."
        app:layout_constraintStart_toEndOf="@id/b0"
        app:layout_constraintEnd_toStartOf="@id/beq"
        app:layout_constraintTop_toTopOf="@id/b0"
        app:layout_constraintBottom_toBottomOf="@id/b0" />

    <Button
        android:id="@+id/beq"
        style="@style/key"
        android:text="="
        app:layout_constraintStart_toEndOf="@id/bdot"
        app:layout_constraintEnd_toStartOf="@id/bplus"
        app:layout_constraintTop_toTopOf="@id/b0"
        app:layout_constraintBottom_toBottomOf="@id/b0" />

    <Button
        android:id="@+id/bplus"
        style="@style/key"
        android:text="+"
        app:layout_constraintStart_toEndOf="@id/beq"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/b0"
        app:layout_constraintBottom_toBottomOf="@id/b0" />
</androidx.constraintlayout.widget.ConstraintLayout>