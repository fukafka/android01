<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/i1"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="20dp"
        android:contentDescription="space station"
        android:src="@drawable/space_station_icon"
        app:layout_constraintEnd_toEndOf="@id/t1"
        app:layout_constraintStart_toStartOf="@id/t1"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iT2"
        android:layout_width="11dp"
        android:layout_height="22dp"
        android:contentDescription="flights"
        android:src="@drawable/rocket_icon"
        app:layout_constraintBottom_toBottomOf="@id/i1"
        app:layout_constraintEnd_toEndOf="@id/t2"
        app:layout_constraintStart_toStartOf="@id/t2"
        app:layout_constraintTop_toTopOf="@id/i1" />

    <ImageView
        android:id="@+id/iT3"
        android:layout_width="28dp"
        android:layout_height="22dp"
        android:contentDescription="rovers"
        android:src="@drawable/rover_icon"
        app:layout_constraintBottom_toBottomOf="@id/i1"
        app:layout_constraintEnd_toEndOf="@id/t3"
        app:layout_constraintStart_toStartOf="@id/t3"
        app:layout_constraintTop_toTopOf="@id/i1" />

    <TextView
        android:id="@+id/t1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Space Stations"
        android:textColor="#FF1B1B1B"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/t2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/i1" />

    <TextView
        android:id="@+id/t2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Flights"
        android:textColor="#FF1B1B1B"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/t1"
        app:layout_constraintEnd_toStartOf="@id/t3"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/t1"
        app:layout_constraintTop_toTopOf="@id/t1" />

    <TextView
        android:id="@+id/t3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Rovers"
        android:textColor="#FF1B1B1B"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/t1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/t2"
        app:layout_constraintTop_toTopOf="@id/t1" />
    <View
        android:id="@+id/bD"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginTop="28dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:background="#FF2B663A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/t1" />

    <TextView
        android:id="@+id/tD"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:text="DCA"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/bD"
        app:layout_constraintStart_toStartOf="@id/bD"
        app:layout_constraintTop_toTopOf="@id/bD" />

    <ImageView
        android:id="@+id/iA"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="arrow"
        android:src="@drawable/double_arrows"
        app:layout_constraintBottom_toBottomOf="@id/bD"
        app:layout_constraintEnd_toEndOf="@id/bD"
        app:layout_constraintStart_toStartOf="@id/bD"
        app:layout_constraintTop_toTopOf="@id/bD" />

    <TextView
        android:id="@+id/tM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:text="MARS"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/bD"
        app:layout_constraintEnd_toEndOf="@id/bD"
        app:layout_constraintTop_toTopOf="@id/bD" />


    <TextView
        android:id="@+id/tO"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="13dp"
        android:layout_marginStart="25dp"
        android:background="#FFB86423"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="52dp"
        android:text="One Way"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bD" />

    <ImageView
        android:id="@+id/iDA"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="one way"
        android:src="@drawable/single_arrow"
        app:layout_constraintBottom_toBottomOf="@id/tO"
        app:layout_constraintEnd_toEndOf="@id/tO"
        app:layout_constraintTop_toTopOf="@id/tO" />

    <TextView
        android:id="@+id/tT"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="25dp"
        android:background="#FFB86423"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="1 Traveller"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tO" />


    <ImageView
        android:id="@+id/iG"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:contentDescription="galaxy"
        android:src="@drawable/galaxy"
        app:layout_constraintBottom_toTopOf="@id/btD"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tT"
        app:layout_constraintVertical_bias="0.36" />

    <ImageView
        android:id="@+id/iR"
        android:layout_width="40dp"
        android:layout_height="82dp"
        android:layout_marginEnd="27dp"
        android:contentDescription="rocket"
        android:src="@drawable/rocket_icon"
        app:layout_constraintBottom_toBottomOf="@id/iG"
        app:layout_constraintEnd_toStartOf="@id/iG"
        app:layout_constraintTop_toTopOf="@id/iG" />


    <Button
        android:id="@+id/btD"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="#FF2B663A"
        android:text="DEPART"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>